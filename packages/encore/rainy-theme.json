{
    "manifest": 1,
    "api": 1,
    "id": "encore",
    "name": "Encore",
    "version": "2.1.1",
    "description": "YouTube Music's look, one to one: Roboto and Material icons, a slim top bar, a guide of rounded rows, shelves of covers and quick picks, the player bar with its red line, and the song's colours washing over the page.",
    "author": "Rainy",
    "license": "MIT",
    "colorScheme": "dark",
    "fullscreen": "standard",
    "tokens": {
        "--bg-primary": "#030303",
        "--bg-secondary": "#030303",
        "--bg-tertiary": "#212121",
        "--bg-elevated": "#282828",
        "--bg-glass": "rgba(3, 3, 3, 0.86)",
        "--text-primary": "#ffffff",
        "--text-secondary": "rgba(255, 255, 255, 0.7)",
        "--text-tertiary": "rgba(255, 255, 255, 0.5)",
        "--accent-primary": "#ffffff",
        "--font-family": "Roboto, Arial, sans-serif",
        "--font-family-display": "Roboto, Arial, sans-serif",
        "--radius-sm": "4px",
        "--radius-md": "8px",
        "--radius-lg": "12px",
        "--radius-card": "8px",
        "--radius-control": "8px",
        "--header-height": "64px",
        "--player-height": "72px",
        "--sidebar-width": "240px",
        "--theme-surface-bar": "#212121",
        "--text-on-accent": "#030303"
    },
    "styles": [
        "css/fonts.css",
        "css/shell.css",
        "css/home.css",
        "css/player.css",
        "css/settings.css"
    ],
    "icons": {
        "add": "icons/add.svg",
        "album": "icons/album.svg",
        "arrow-back": "icons/arrow-back.svg",
        "arrow-forward": "icons/arrow-forward.svg",
        "auto-awesome": "icons/auto-awesome.svg",
        "cast": "icons/cast.svg",
        "check": "icons/check.svg",
        "chevron-left": "icons/chevron-left.svg",
        "chevron-right": "icons/chevron-right.svg",
        "close": "icons/close.svg",
        "cloud-download": "icons/cloud-download.svg",
        "delete": "icons/delete.svg",
        "edit": "icons/edit.svg",
        "equalizer": "icons/equalizer.svg",
        "expand-more": "icons/expand-more.svg",
        "explore": "icons/explore.svg",
        "graphic-eq": "icons/graphic-eq.svg",
        "grid-view": "icons/grid-view.svg",
        "group": "icons/group.svg",
        "heart": "icons/heart.svg",
        "help": "icons/help.svg",
        "history": "icons/history.svg",
        "info": "icons/info.svg",
        "keyboard": "icons/keyboard.svg",
        "library-music": "icons/library-music.svg",
        "list-view": "icons/list-view.svg",
        "logout": "icons/logout.svg",
        "menu": "icons/menu.svg",
        "more-horiz": "icons/more-vert.svg",
        "more-vert": "icons/more-vert.svg",
        "music-note": "icons/music-note.svg",
        "palette": "icons/palette.svg",
        "pause": "icons/pause.svg",
        "person": "icons/person.svg",
        "play-circle": "icons/play-circle.svg",
        "play": "icons/play.svg",
        "playlist-add": "icons/playlist-add.svg",
        "playlist-play": "icons/playlist-play.svg",
        "queue-music": "icons/queue-music.svg",
        "queue-play-next": "icons/queue-play-next.svg",
        "radio": "icons/radio.svg",
        "refresh": "icons/refresh.svg",
        "repeat": "icons/repeat.svg",
        "save-alt": "icons/save-alt.svg",
        "search": "icons/search.svg",
        "settings": "icons/settings.svg",
        "share": "icons/share.svg",
        "shuffle": "icons/shuffle.svg",
        "skip-next": "icons/skip-next.svg",
        "skip-previous": "icons/skip-previous.svg",
        "sort": "icons/sort.svg",
        "speed": "icons/speed.svg",
        "sync": "icons/sync.svg",
        "thumb-down": "icons/thumb-down.svg",
        "thumb-up": "icons/thumb-up.svg",
        "timer": "icons/timer.svg",
        "volume-up": "icons/volume-up.svg"
    },
    "strings": {
        "en": {
            "Library": "Home",
            "Browse": "Library",
            "Discover Music": "Explore",
            "Recently Played": "History",
            "Smart Mix": "Mixed for you",
            "All Songs": "Quick picks",
            "Liked Music": "Liked music",
            "Up Next": "Up next",
            "Search your library": "Search songs, albums, artists"
        },
        "es": {
            "Library": "Inicio",
            "Browse": "Biblioteca",
            "Discover Music": "Explorar",
            "Recently Played": "Historial",
            "Smart Mix": "Mixes para ti",
            "All Songs": "Selección rápida",
            "Liked Music": "Música que te gusta",
            "Up Next": "A continuación",
            "Lyrics": "Letra",
            "Search your library": "Busca canciones, álbumes, artistas"
        },
        "ca": {
            "Library": "Inici",
            "Browse": "Biblioteca",
            "Discover Music": "Explora",
            "Recently Played": "Historial",
            "Smart Mix": "Mixos per a tu",
            "All Songs": "Selecció ràpida",
            "Liked Music": "Música que t'agrada",
            "Up Next": "A continuació",
            "Lyrics": "Lletra",
            "Search your library": "Cerca cançons, àlbums, artistes"
        }
    },
    "entry": "index.js",
    "preview": "preview.jpg",
    "i18n": {
        "es": {
            "description": "El aspecto de YouTube Music, uno a uno: Roboto e iconos Material, barra superior fina, guía de filas redondeadas, estanterías de carátulas y selección rápida, la barra del reproductor con su línea roja, y los colores de la canción tiñendo la página."
        },
        "ca": {
            "description": "L'aspecte de YouTube Music, un a un: Roboto i icones Material, barra superior fina, guia de files arrodonides, prestatges de caràtules i selecció ràpida, la barra del reproductor amb la línia vermella, i els colors de la cançó tenyint la pàgina."
        }
    }
}
