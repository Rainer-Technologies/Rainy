# Database backend. Leave RAINY_DB unset to use MySQL with the MYSQL_* values
# below. No MySQL server? Set RAINY_DB=sqlite: everything is then stored in a
# single file (SQLITE_PATH, default data/rainy.db) and MYSQL_* is ignored.
# RAINY_DB=sqlite
# SQLITE_PATH=data/rainy.db

# Used when running the application directly. Docker Compose overrides this
# value to use the bundled database service.
MYSQL_HOST=127.0.0.1:3306
MYSQL_USER=rainy
MYSQL_PASSWORD=change-this-app-password
MYSQL_DATABASE=rainy
MYSQL_ROOT_PASSWORD=change-this-root-password
# Required: >=32 random chars. Generate: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Docker Compose settings
RAINY_PORT=6969
# Use an absolute path to an existing library, or keep ./music for a new one.
MUSIC_LIBRARY_PATH=./music

# Light show analysis device: auto (NVIDIA GPU if usable, else CPU) | cpu | cuda | cuda:N
# RAINY_LIGHTSHOW_DEVICE=auto
# CPU threads for light show analysis (default: cores, max 8)
# RAINY_LIGHTSHOW_THREADS=4
