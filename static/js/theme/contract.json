    "--spacing-lg",
    "--spacing-xl",
    "--spacing-2xl",
    "--radius-sm",
    "--radius-md",
    "--radius-lg",
    "--radius-xl",
    "--radius-full",
    "--radius-card",
    "--radius-control",
    "--transition-fast",
    "--transition-base",
    "--transition-slow",
    "--transition-normal",
    "--focus-ring",
