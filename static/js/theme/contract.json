  "states": [
    {
      "name": "data-theme",
      "values": "the id of the theme in use (rainy is Rainy's own)",
      "description": "Which theme is on."
    },
    {
      "name": "data-color-scheme",
      "values": "dark | light",
      "description": "The theme's colour scheme."
    },
    {
      "name": "data-auth",
      "values": "setup | login | app",
      "description": "Which screen is showing."
    },
    {
      "name": "data-view",
      "values": "library | playlist | albums | artists | recent | smartmix | discover | friends",
      "description": "The view in the main area."
    },
    {
      "name": "data-playing",
      "values": "true | false",
      "description": "Music is playing."
    },
    {
      "name": "data-has-track",
      "values": "true | false",
      "description": "There is a song in the player."
    },
    {
      "name": "data-fullscreen",
      "values": "true | false",
      "description": "The full player is open."
    },
    {
      "name": "data-settings",
      "values": "true | false",
      "description": "Settings is open."
    },
    {
      "name": "data-sidebar",
      "values": "open | collapsed",
      "description": "Whether the sidebar is collapsed to icons."
    },
    {
      "name": "class no-anime",
      "values": "present or not",
      "description": "The user hid the anime logo."
    }
  ],
